# Copy to .env.local for local dev. Never commit real values — .env*.local is
# gitignored, and these two go into the GitHub Pages deploy workflow as repo
# variables (both are public-safe; the secret key lives only in Vercel).

# Stripe publishable key. Public by design — it identifies the account, it
# can't move money. pk_test_… while you're testing.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Origin of the checkout-api Vercel deployment, no trailing slash.
# e.g. https://rankify-checkout-api.vercel.app
NEXT_PUBLIC_CHECKOUT_API=

# Web3Forms access key for the contact and newsletter forms. Public by design —
# it can only deliver to the address the key is registered to.
NEXT_PUBLIC_WEB3FORMS_KEY=
