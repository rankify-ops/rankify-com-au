# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch verification screenshots
/.firecrawl/

# nested project deps
checkout-api/node_modules

# Baked in at build time from the CRM price record. Committing it would put a
# stale copy of every price in git, which is the drift this exists to end.
# Regenerated by `npm run pricing` on every build, so it is never committed.
src/content/pricing.generated.ts
# checkout-api/api/_pricing.generated.ts is deliberately NOT ignored: that
# project deploys to Vercel with no build step, so the committed file is the
# only way the record's amounts reach the endpoints that charge.
